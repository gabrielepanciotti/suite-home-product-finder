# Copy this file to .env and replace example values before using a shared DB.
PORT=10008

# PostgreSQL. Leave DATABASE_URL unset to use the JSON-only mode.
DB_USER=homeproductfinder
DB_PASSWORD=example-not-a-secret
DB_NAME=homeproductfinder
DB_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://homeproductfinder:example-not-a-secret@localhost:5432/homeproductfinder

# Optional eBay Browse API credentials.
EBAY_BROWSE_CLIENT_ID=
EBAY_BROWSE_CLIENT_SECRET=

# Optional frontend development proxy target.
VITE_BACKEND_PROXY_TARGET=http://localhost:10008
