{
  "schemaVersion": "2.0",
  "name": "HomeProductFinder",
  "slug": "homeProductFinder",
  "type": "fastapi-react-app",
  "visibility": "public",
  "hostBase": "homeproductfinder.life.local",
  "inherits": "../Life/node.config",
  "taxonomy": { "id": "homeProductFinder", "cluster": ["Home"], "displayName": "HomeProductFinder", "former": "CasaProdotti", "commercial": false },
  "deploy": {
    "backendPkg": "home_product_finder_backend",
    "migrations": true,
    "database": {
      "name": "homeproductfinder",
      "user": "homeproductfinder",
      "host": "homeproductfinder-db",
      "driver": "postgresql+asyncpg",
      "image": "postgres:16-alpine",
      "volume": "homeproductfinder_homeproductfinder_pgdata"
    }
  },
  "brain_profile": "standard",
  "tooling": {
    "grants": [
      { "kind": "mcp-toolset", "ref": "graph,brain,db", "scope": "self" }
    ],
    "deny": [],
    "subagents": {
      "api-reviewer": { "toolsets": ["db"], "readOnly": true },
      "ui-reviewer": { "toolsets": ["brain"], "readOnly": true }
    }
  },
  "capabilities": ["vault", "product-finder", "price-search", "product-comparison", "build", "deploy"],
  "agents": { "archetypes": [] },
  "mcp": { "toolsets": ["brain", "db"], "readOnly": true, "dbUrlEnv": "DATABASE_URL" },
  "children": [],
  "famiglia": "finder",
  "vista": {
    "sezioni": [
      { "id": "cerca", "titolo": "Cerca", "min": "player" },
      { "id": "risultati", "titolo": "Risultati", "min": "player" },
      { "id": "salvati", "titolo": "Salvati", "min": "player" },
      { "id": "spazi", "titolo": "Spazi da riempire", "min": "player" },
      { "id": "contenere", "titolo": "In cosa lo metto", "min": "player" },
      { "id": "catalogo", "titolo": "Catalogo scatole", "min": "player" },
      { "id": "impostazioni", "titolo": "Impostazioni", "min": "admin" }
    ],
    "azioni": { "ricerca.crea": "creator", "ricerca.elimina": "admin", "salvato.crea": "creator", "salvato.modifica": "creator", "salvato.elimina": "creator", "impostazioni.modifica": "admin" }
  }
}
